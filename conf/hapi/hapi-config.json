{
	"app": {
		"emailStatus": true,
    "emailStatusTo": "rweigel@gmu.edu",
		"emailMethod": "sendmail",
		"emailStatusCron": {
			"timezone": "America/New_York",
			"expression": "0 0 7 * * *"
		},
		"logDeleteCron": {
			"timezone": "America/New_York",
			"expression": "0 0 9 * * *"
		},
		"logDelete": {
			"emails": {
				"deleteAfterDays": 30
			},
			"requests": {
				"deleteAfterDays": 90
			}
		},
		"debug": false,
		"logDirectory": "log",
		"hostname": "",
		"urlTestsFile": "conf/hapi/hapi.json",
		"serverPort": 4444,
		"publicHTML": "https://hapi-server.org/urlwatcher/"
	},
	"sendmail": {
		"from": "urlwatcher@hapi-server.org"
	}
}
